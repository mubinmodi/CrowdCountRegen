{
  "app": "uv run python app.py",
  "context": {
    "crowdcounting:schedule": false,
    "crowdcounting:stopCron": "cron(0 23 * * ? *)",
    "crowdcounting:startCron": "cron(0 8 * * ? *)",
    "crowdcounting:timezone": "America/New_York",
    "crowdcounting:availabilityZones": "",
    "crowdcounting:amiId": "",
    "crowdcounting:maxVideoViewers": 40,
    "crowdcounting:videoSessionMaxS": 1800,
    "crowdcounting:videoIdleTimeoutS": 600,
    "crowdcounting:wafRateLimit": 2000,
    "crowdcounting:monthlyBudgetUsd": 450,
    "crowdcounting:alertEmail": "",
    "crowdcounting:githubRepository": "mubinmodi/CrowdCountRegen",
    "crowdcounting:githubOidcProviderArn": "",
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws"
    ],
    "@aws-cdk/customresources:installLatestAwsSdkDefault": false
  }
}
