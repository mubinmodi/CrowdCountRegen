{
  "app": "uv run python app.py",
  "context": {
    "zonewatch:schedule": false,
    "zonewatch:stopCron": "cron(0 23 * * ? *)",
    "zonewatch:startCron": "cron(0 8 * * ? *)",
    "zonewatch:timezone": "America/New_York",
    "zonewatch:availabilityZones": "",
    "zonewatch:amiId": "",
    "zonewatch:maxVideoViewers": 40,
    "zonewatch:videoSessionMaxS": 1800,
    "zonewatch:videoIdleTimeoutS": 600,
    "zonewatch:wafRateLimit": 2000,
    "zonewatch:monthlyBudgetUsd": 450,
    "zonewatch:alertEmail": "",
    "zonewatch:githubRepository": "mubinmodi/Zonewatch",
    "zonewatch:githubOidcProviderArn": "",
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws"
    ],
    "@aws-cdk/customresources:installLatestAwsSdkDefault": false
  }
}
