# Copy to backend/.env and adjust. All settings are optional except ZW_SECRET_KEY in production.
ZW_SECRET_KEY=change-me-run-openssl-rand-hex-32
# ZW_DATABASE_URL=postgresql+psycopg://user:pass@localhost/zonewatch   # needs: uv sync --extra postgres
# ZW_DETECTOR=ultralytics            # ultralytics | rfdetr | fake
# ZW_DETECTOR_MODEL=                 # ultralytics: weights name/path (default models/yolo26n.pt); rfdetr: nano|small|medium|large|base
# ZW_CONFIDENCE=0.4
# ZW_DEVICE=                         # cpu | cuda:0 | mps (auto when unset)
# ZW_MAX_FPS=15
# ZW_FRAME_WIDTH=960
# ZW_COOKIE_SECURE=false             # set true when served over HTTPS
# ZW_OPEN_TIMEOUT_S=8                # camera connect timeout
# ZW_READ_TIMEOUT_S=8                # reconnect when no frame arrives for this long
# ZW_RECONNECT_MAX_DELAY_S=30        # cap for exponential reconnect backoff
