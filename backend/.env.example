# Copy to backend/.env and adjust. All settings are optional except CC_SECRET_KEY in production.
CC_SECRET_KEY=change-me-run-openssl-rand-hex-32
# CC_DATABASE_URL=postgresql+psycopg://user:pass@localhost/crowdcounting   # needs: uv sync --extra postgres
# CC_DETECTOR=ultralytics            # ultralytics | rfdetr | fake
# CC_DETECTOR_MODEL=                 # ultralytics: weights name/path (default models/yolo26n.pt); rfdetr: nano|small|medium|large|base
# CC_CONFIDENCE=0.4
# CC_DEVICE=                         # cpu | cuda:0 | mps (auto when unset)
# CC_MAX_FPS=15
# CC_FRAME_WIDTH=960
# CC_COOKIE_SECURE=false             # set true when served over HTTPS
# CC_OPEN_TIMEOUT_S=8                # camera connect timeout
# CC_READ_TIMEOUT_S=8                # reconnect when no frame arrives for this long
# CC_RECONNECT_MAX_DELAY_S=30        # cap for exponential reconnect backoff
